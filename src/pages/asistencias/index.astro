---
import Layout from "../../layouts/Layout.astro";
import AttendanceTable from "../../components/AttendanceTable.astro";
import { getListClass } from "../../services/sigps/asistencia.service";
import { createSigpsSession } from "../../interceptors/session.interceptor";
import type { ListClassParams } from "../../services/sigps/asistencia.service";
import type { SigpsContext } from "../../interfaces/SigpsContext.interface";
import DatePicker from "../../components/ui/DatePicker.astro";
import Button from "../../components/ui/Button.astro";
const session = await Astro.session?.get<SigpsContext>("sigps");
if (!session) return Astro.redirect("/");
const client = createSigpsSession(session.auth);

const now = Temporal.Now.plainDateISO().toString();

const fecInicio = Astro.url.searchParams.get("fecInicio") ?? now;
const fecFin = Astro.url.searchParams.get("fecFin") ?? "";

const initParams: ListClassParams = {
  pageNum: 1,
  pageSize: 100,
  idUsuario: session.user.id,
  idUnidadOperativa: session.operationalUnit.id,
  fecInicio,
  fecFin,
};
const sigpsClasses = await getListClass(client, initParams);

const total = sigpsClasses.list.length ?? 0;
const attendances = sigpsClasses.list ?? [];
const open =
  sigpsClasses.list.filter((v) => v.estado === "ABIERTO").length ?? 0;
const finished =
  sigpsClasses.list.filter((v) => v.estado === "FINALIZADO").length ?? 0;
---

<Layout>
  <main
    class="mx-auto
      w-full
      max-w-7xl
      px-4
      py-6
      sm:px-6
      lg:px-8
      lg:py-8"
  >
    <!-- PAGE HEADER -->
    <header
      class="mb-6
        flex
        flex-col
        gap-4
        sm:flex-row
        sm:items-center
        sm:justify-between"
    >
      <div>
        <h1
          class="text-2xl
            font-semibold
            tracking-tight
            text-slate-950
            dark:text-white"
        >
          Asistencias
        </h1>

        <p
          class="mt-1
            text-sm
            text-slate-500
            dark:text-slate-400"
        >
          Consulta y administra las asistencias registradas en SIGPS.
        </p>
      </div>

      <a href="/asistencias/nueva">
        <Button> Nueva asistencia </Button>
      </a>
    </header>

    <!-- FILTERS -->
    <section
      class="mb-6
        rounded-2xl
        border border-slate-200
        bg-white
        p-5
        shadow-sm
        dark:border-slate-800
        dark:bg-slate-900"
    >
      <div class="mb-4">
        <h2
          class="text-sm
            font-semibold
            text-slate-900
            dark:text-white"
        >
          Período de consulta
        </h2>

        <p class="mt-1
            text-xs
            text-slate-500">
          Selecciona el rango de fechas que deseas consultar.
        </p>
      </div>

      <form
        method="GET"
        class="grid
          grid-cols-1
          gap-4
          md:grid-cols-2
          lg:grid-cols-[1fr_1fr_auto]
          lg:items-end"
      >
        <DatePicker
          name="fecInicio"
          label="Fecha de inicio"
          value={fecInicio}
          required
        />

        <DatePicker
          name="fecFin"
          label="Fecha de fin"
          value={fecFin}
          required
        />

        <Button type="submit" size="md"> Consultar </Button>
      </form>
    </section>

    <!-- STATS -->
    <section
      class="mb-6
        grid
        grid-cols-1
        gap-4
        sm:grid-cols-3"
    >
      <article
        class="rounded-2xl
          border border-slate-200
          bg-white
          p-5
          shadow-sm
          dark:border-slate-800
          dark:bg-slate-900"
      >
        <p class="text-sm
            text-slate-500">Total</p>

        <p
          class="mt-2
            text-3xl
            font-semibold
            tracking-tight
            dark:text-white"
        >
          {total}
        </p>
      </article>

      <article
        class="rounded-2xl
          border border-accent-100
          bg-accent-50
          p-5
          dark:border-slate-800
          dark:bg-slate-900"
      >
        <p class="text-sm
            text-accent-700">Abiertas</p>

        <p
          class="mt-2
            text-3xl
            font-semibold
            text-accent-700"
        >
          {open}
        </p>
      </article>

      <article
        class="rounded-2xl
          border border-success-100
          bg-success-50
          p-5
          dark:border-slate-800
          dark:bg-slate-900"
      >
        <p class="text-sm
            text-success-700">Finalizadas</p>

        <p
          class="mt-2
            text-3xl
            font-semibold
            text-success-700"
        >
          {finished}
        </p>
      </article>
    </section>

    <AttendanceTable attendances={attendances} />
  </main>
</Layout>
